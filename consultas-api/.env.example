# Copie para .env e preencha localmente. NUNCA commitar .env (Ex. 11).
# Em DEV, `source scripts/dev_env.sh` já exporta valores fictícios equivalentes.
ENV=dev
# Persistência (Ex. 11)
DATABASE_URL=sqlite:///./consultas.db
# JWT (Ex. 6/11) — gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-por-um-segredo-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=http://localhost:5173
# Seed de usuários (senhas fictícias de DEV)
SEED_SENHA_ADMIN=defina-uma-senha
SEED_SENHA_RECEPCAO=defina-uma-senha
SEED_SENHA_CARLA=defina-uma-senha
SEED_SENHA_DIEGO=defina-uma-senha
SEED_TOTP_ADMIN=base32-secret-do-admin
# Cliente M2M do laboratório (Ex. 7)
LAB_CLIENT_ID=lab-parceiro
LAB_CLIENT_SECRET=defina-um-secret
